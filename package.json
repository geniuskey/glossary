{
  "name": "glossary",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://geniuskey.github.io/glossary/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geniuskey/glossary.git"
  },
  "bugs": {
    "url": "https://github.com/geniuskey/glossary/issues"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "pnpm --filter @glossary/web lint",
    "test": "turbo run test",
    "test:coverage": "pnpm --filter @glossary/web test:coverage",
    "typecheck": "turbo run typecheck",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8",
    "@babel/preset-react": "^8",
    "@babel/preset-typescript": "^8",
    "@eslint/js": "^10",
    "eslint": "^10",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2",
    "vite": "^8",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1"
  }
}
