DATABASE_URL=postgres://glossary:glossary@localhost:5434/glossary
DATABASE_URL_TEST=postgres://glossary:glossary@localhost:5434/glossary_test
POSTGRES_PASSWORD=glossary
# 허용할 출처(origin)를 쉼표로 구분. 미설정 또는 빈 값이면 모든 출처에서 /embed를 허용한다.
GLOSSARY_EMBED_ANCESTORS=
# 회의 지식 인박스에서 열 회의록 허브의 Confluence URL. 회의록 원문은 이곳에서만 관리한다.
GLOSSARY_CONFLUENCE_MEETINGS_URL=
# 관리자 화면에 저장하는 AI·RAG API 키와 custom header 값을 암호화한다.
# 운영에서는 `openssl rand -base64 48` 등으로 만든 고정값을 사용한다.
GLOSSARY_ENCRYPTION_KEY=

# oauth2-proxy가 검증한 헤더를 안전하게 받을 수 있는 배포에서만 true로 바꾼다.
# 실제 로그인 방식은 관리자 패널 → 로그인 · SSO에서 고른다. 앱 포트 직접 접근은 반드시 막아야 한다.
OAUTH2_PROXY_ENABLED=false
# DB 설정이 아직 없는 최초 부팅의 ID/비밀번호 로그인 초기값. 이후 관리자 패널에서 관리한다.
PASSWORD_LOGIN_ENABLED=true
# SSO로 처음 들어올 관리자의 회사 이메일. 대소문자는 구분하지 않는다.
INITIAL_ADMIN_EMAIL=
# oauth2-proxy prefix/경로가 기본 /oauth2/start와 다를 때 완성된 로그인 URL을 지정한다.
SSO_LOGIN_URL=
OAUTH2_PROXY_PREFERRED_USERNAME_HEADER=X-Forwarded-Preferred-Username
OAUTH2_PROXY_EMAIL_HEADER=X-Forwarded-Email
OAUTH2_PROXY_GROUPS_HEADER=X-Forwarded-Groups
# 직접 OAuth2 코드 흐름도 함께 쓸 때만 email로 맞춘다.
OAUTH2_SUBJECT_FIELD=
