DATABASE_URL=postgres://grossary:grossary@localhost:5434/grossary
DATABASE_URL_TEST=postgres://grossary:grossary@localhost:5434/grossary_test
POSTGRES_PASSWORD=grossary
# Confluence 출처(origin)를 쉼표로 구분. 비우면 다른 사이트의 iframe을 허용하지 않는다.
GROSSARY_EMBED_ANCESTORS=

# oauth2-proxy가 인증한 사용자를 nginx 헤더로 받을 때만 oauth2-proxy로 바꾼다.
# 앱 포트에 직접 접근할 수 없고 nginx가 아래 헤더를 항상 덮어쓰는 구성이어야 한다.
AUTH_MODE=local
SSO_TRUST_PROXY_HEADERS=false
OAUTH2_PROXY_PREFERRED_USERNAME_HEADER=X-Forwarded-Preferred-Username
OAUTH2_PROXY_EMAIL_HEADER=X-Forwarded-Email
OAUTH2_PROXY_GROUPS_HEADER=X-Forwarded-Groups
# 직접 OAuth2 코드 흐름도 함께 쓸 때만 email로 맞춘다.
OAUTH2_SUBJECT_FIELD=
