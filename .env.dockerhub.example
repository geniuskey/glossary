# 앱과 마이그레이터는 반드시 같은 릴리스 버전을 사용한다.
GLOSSARY_IMAGE=euiyun/glossary:0.1.7
GLOSSARY_MIGRATOR_IMAGE=euiyun/glossary:0.1.7-migrator
GLOSSARY_PORT=3000

# DATABASE_URL에도 들어가므로 영문·숫자·_·-로 된 URL-safe 값을 권장한다.
# 예: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password

# 예: https://confluence.example.com
GLOSSARY_EMBED_ANCESTORS=
# AI API 키와 custom header 암호화용. 배포 후 값을 바꾸면 저장된 비밀값을 읽을 수 없다.
# 예: openssl rand -base64 48
GLOSSARY_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key

# oauth2-proxy가 검증한 헤더를 안전하게 받을 수 있는 배포에서만 true로 바꾼다.
# 실제 로그인 방식은 관리자 패널 → 로그인 · SSO에서 고른다. nginx는 같은 이름 헤더를 덮어써야 한다.
OAUTH2_PROXY_ENABLED=false
# DB 설정이 아직 없는 최초 부팅의 ID/비밀번호 로그인 초기값. 이후 관리자 패널에서 관리한다.
PASSWORD_LOGIN_ENABLED=true
# SSO로 처음 들어올 관리자의 회사 이메일. SSO 전용 운영이면 반드시 지정한다.
INITIAL_ADMIN_EMAIL=
# 비우면 oauth2-proxy 모드에서 /oauth2/start?rd=%2F를 사용한다.
SSO_LOGIN_URL=
OAUTH2_PROXY_PREFERRED_USERNAME_HEADER=X-Forwarded-Preferred-Username
OAUTH2_PROXY_EMAIL_HEADER=X-Forwarded-Email
OAUTH2_PROXY_GROUPS_HEADER=X-Forwarded-Groups
# 직접 OAuth2 코드 흐름도 함께 쓸 때만 email로 맞춘다.
OAUTH2_SUBJECT_FIELD=
