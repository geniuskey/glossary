# Docker Hub 이미지 배포용 예제다. 로컬 개발 및 소스 빌드 배포에는 .env.example을 사용한다.

# 앱·마이그레이터·RAG 워커는 반드시 같은 릴리스 버전을 사용한다.
GLOSSARY_IMAGE=euiyun/glossary:0.3.1
GLOSSARY_MIGRATOR_IMAGE=euiyun/glossary:0.3.1-migrator
GLOSSARY_WORKER_IMAGE=euiyun/glossary:0.3.1-worker
GLOSSARY_PORT=3000

# DATABASE_URL에도 들어가므로 영문·숫자·_·-로 된 URL-safe 값을 권장한다.
# 예: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password

# 예: https://confluence.example.com
GLOSSARY_EMBED_ANCESTORS=
# 회의 지식 인박스에서 열 회의록 허브의 Confluence URL.
GLOSSARY_CONFLUENCE_MEETINGS_URL=
# AI·RAG API 키와 custom header 암호화용. 배포 후 값을 바꾸면 저장된 비밀값을 읽을 수 없다.
# 예: openssl rand -base64 48
GLOSSARY_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
# 브라우저 세션 변경 요청을 허용할 실제 공개 HTTPS origin. 쉼표로 여러 개를 지정할 수 있다.
GLOSSARY_ALLOWED_ORIGINS=https://glossary.example.com
# 직접 OIDC/OAuth2의 redirect URI를 만들 공개 기준 URL. 비우면 위 허용 origin의 첫 값을 쓴다.
GLOSSARY_BASE_URL=
# 사내 AI·RAG 서버가 사설망에 있을 때 허용할 호스트를 쉼표로 구분한다. 기본값은 차단이다.
# 폐쇄망에서 전부 허용하려면 `*`. link-local(169.254.x)은 이 값으로도 허용되지 않는다.
GLOSSARY_AI_ALLOWED_PRIVATE_HOSTS=
# TLS 프록시가 x-forwarded-* 헤더를 항상 덮어쓰는 구성이므로 true로 둔다.
GLOSSARY_TRUST_PROXY_HEADERS=true

# 워커 보존 기간(일)과 처리량. 특별한 튜닝이 필요하지 않으면 기본값을 유지한다.
GLOSSARY_AI_RUN_RETENTION_DAYS=180
GLOSSARY_AUDIT_RETENTION_DAYS=365
GLOSSARY_ATTACHMENT_RETENTION_DAYS=30
GLOSSARY_RAG_WORKER_BATCH=8
GLOSSARY_RAG_WORKER_IDLE_MS=2000
GLOSSARY_RAG_WORKER_BUSY_MS=100

# oauth2-proxy가 검증한 헤더를 안전하게 받을 수 있는 배포에서만 true로 바꾼다.
# 실제 로그인 방식은 관리자 패널 → 로그인 · SSO에서 고른다. nginx는 같은 이름 헤더를 덮어써야 한다.
OAUTH2_PROXY_ENABLED=false
# DB 설정이 아직 없는 최초 부팅의 ID/비밀번호 로그인 초기값. 이후 관리자 패널에서 관리한다.
PASSWORD_LOGIN_ENABLED=true
# SSO로 처음 들어올 관리자의 회사 이메일. SSO 전용 운영이면 반드시 지정한다.
INITIAL_ADMIN_EMAIL=
# 비우면 oauth2-proxy 모드에서 /oauth2/start?rd=%2F를 사용한다.
SSO_LOGIN_URL=
OAUTH2_PROXY_PREFERRED_USERNAME_HEADER=X-Forwarded-Preferred-Username
OAUTH2_PROXY_EMAIL_HEADER=X-Forwarded-Email
OAUTH2_PROXY_GROUPS_HEADER=X-Forwarded-Groups
# 직접 OAuth2 코드 흐름도 함께 쓸 때만 email로 맞춘다.
OAUTH2_SUBJECT_FIELD=
