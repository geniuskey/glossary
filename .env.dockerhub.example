# 앱과 마이그레이터는 반드시 같은 릴리스 버전을 사용한다.
GROSSARY_IMAGE=euiyun/grossary:0.1.1
GROSSARY_MIGRATOR_IMAGE=euiyun/grossary:0.1.1-migrator
GROSSARY_PORT=3000

# DATABASE_URL에도 들어가므로 영문·숫자·_·-로 된 URL-safe 값을 권장한다.
# 예: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password

# 예: https://confluence.example.com
GROSSARY_EMBED_ANCESTORS=
