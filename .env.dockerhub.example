# Docker Hub 계정과 배포할 태그로 바꾼다.
GROSSARY_IMAGE=your-dockerhub-id/grossary:latest
GROSSARY_MIGRATOR_IMAGE=your-dockerhub-id/grossary:latest-migrator
GROSSARY_PORT=3000

# DATABASE_URL에도 들어가므로 영문·숫자·_·-로 된 URL-safe 값을 권장한다.
# 예: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password

# 예: https://confluence.example.com
GROSSARY_EMBED_ANCESTORS=
